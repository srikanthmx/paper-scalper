# Alpaca MARKET DATA credentials (any key works for data; we never touch trading endpoints)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Instrument / candles
SYMBOL=BTC/USD
CANDLE_SECONDS=60

# Paper account
STARTING_EQUITY=10000
FEE_BPS=25            # Alpaca crypto taker fee, lowest tier. Set 15 for maker-tier modeling.
SLIPPAGE_BPS=3

# Risk
RISK_PER_TRADE_PCT=0.5
MAX_NOTIONAL_FRACTION=0.5
DAILY_STOP_PCT=2.0
MAX_CONSECUTIVE_LOSSES=3
MAX_HOLD_SECONDS=300
COOLDOWN_CANDLES=3

# Strategy
VOL_SPIKE_MULT=1.3
MAX_SPREAD_BPS=5
DB_PATH=paper_scalper.db
